{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["sin1"],
  "env": {
    "NEXTAUTH_URL": {
      "description": "The URL of your deployed application (e.g., https://si-japirs.vercel.app)",
      "value": "https://si-japirs.vercel.app",
      "required": true
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
